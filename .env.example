# Copy to .env.local (gitignored) and fill in. Load with: uv run --env-file .env.local polyglot
#
# API key for whichever OpenAI-compatible endpoint you point at. Not needed for a local
# Ollama; required for ollama.com and most hosted providers.
POLYGLOT_API_KEY=

# Connection defaults. Omit to use localhost:11434 with gpt-oss:20b.
# For Ollama's cloud: POLYGLOT_HOST=ollama.com and POLYGLOT_PORT=443
#POLYGLOT_HOST=ollama.com
#POLYGLOT_PORT=443
#POLYGLOT_MODEL=gpt-oss:120b

# The base path the OpenAI-compatible API is served under. /v1 for nearly everyone; Gemini
# uses /v1beta/openai and Groq uses /openai/v1. The UI's provider list sets this for you.
#POLYGLOT_PATH=/v1
